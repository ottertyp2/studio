/**
 * @fileoverview Firestore Security Rules for BioThrust Dashboard.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model, ensuring that only authenticated users can access their own data.
 * A 'superadmin' role is established to allow for global management capabilities required by the admin panel.
 *
 * Data Structure:
 * - Global data (readable by all, writable by admins): /vessel_types, /testbenches, /app_settings
 * - User-owned data (readable/writable only by owner or admin): /users/{userId} and all subcollections.
 *
 * Key Security Decisions:
 * - Default access is DENIED. All access must be explicitly granted.
 * - `isSuperAdmin()` function provides a reusable way to check for administrative privileges.
 * - User data is strictly isolated based on the authenticated user's ID.
 */
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions to make rules more readable and reusable.
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Checks if the requesting user has the 'superadmin' role in their user profile.
    function isSuperAdmin() {
      // Use exists() to safely check for the document before accessing its data.
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin';
    }
    
    // Global, public-read collections that are managed by admins.
    match /vessel_types/{vesselTypeId} {
      // All authenticated users can read the list of vessel types.
      allow get, list: if isSignedIn();
      // Only superadmins can create, update, or delete vessel type definitions.
      allow write: if isSuperAdmin();
    }
    
    match /testbenches/{testBenchId} {
       // All authenticated users can read the list of test benches.
       allow get, list: if isSignedIn();
       // Only superadmins can manage the test benches.
       allow write: if isSuperAdmin();
    }
    
    match /app_settings/{settingsId} {
      // App settings (like sign-up allowance) are public to read.
      allow get: if true;
      // Only superadmins can change global settings.
      allow write: if isSuperAdmin();
    }

    // Rules for the 'users' collection itself.
    match /users/{userId} {
      // A user can get their own profile, and admins can get any profile.
      allow get: if isOwner(userId) || isSuperAdmin();
      // Only admins can list all users.
      allow list: if isSuperAdmin();
      // A user can create their own profile document (e.g., on sign-up).
      allow create: if isOwner(userId);
      // A user can update their own profile, and admins can update any profile.
      allow update: if isOwner(userId) || isSuperAdmin();
      // Admins can delete any user except themselves.
      allow delete: if isSuperAdmin() && request.auth.uid != userId;
    }

    // Generic rule for all user-owned subcollections (test_sessions, batches, etc.).
    // This provides a secure default for any data nested under a user's document.
    match /users/{userId}/{collection}/{docId} {
       // A user can only read/write documents in their own subcollections. Admins have full access.
       allow read, write: if isOwner(userId) || isSuperAdmin();
    }
    
    // Explicit rule for deeply nested sensor_data. This inherits the logic from the rule above
    // but is kept for clarity.
    match /users/{userId}/test_sessions/{testSessionId}/sensor_data/{sensorDataId} {
        allow read, write: if isOwner(userId) || isSuperAdmin();
    }
  }
}
