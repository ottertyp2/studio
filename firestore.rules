rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      // Use exists() to check for document existence to prevent errors on non-existent paths.
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin';
    }
    
    // Global, public-read collections
    match /vessel_types/{vesselTypeId} {
      allow get, list: if true;
      allow write: if isSuperAdmin(); // Only admins can change vessel definitions
    }
    
    match /testbenches/{testBenchId} {
       allow get, list: if true;
       allow write: if isSuperAdmin(); // Only admins can manage test benches
    }
    
    match /app_settings/{settingsId} {
      allow get: if true;
      allow write: if isSuperAdmin();
    }

    // User-specific data
    match /users/{userId} {
      allow get: if isOwner(userId) || isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isSuperAdmin();
      allow delete: if isSuperAdmin() && request.auth.uid != userId;
    }

    // All user-generated content is nested under their own user document
    match /users/{userId}/{collection}/{docId} {
       allow read, write: if isOwner(userId) || isSuperAdmin();
    }
    
    match /users/{userId}/test_sessions/{testSessionId}/sensor_data/{sensorDataId} {
        allow read, write: if isOwner(userId) || isSuperAdmin();
    }
  }
}
