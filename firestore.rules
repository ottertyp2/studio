rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // This rule allows any authenticated user to perform any action on any collection.
    // This is required for the admin panel to list collections like `testbenches`, `vessel_types`, etc.
    match /{path=**} {
        allow read, write: if request.auth != null;
    }
  }
}
