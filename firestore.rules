rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    
    match /app_settings/config {
      allow read, write: if true;
    }

    match /users/{userId} {
      // Any authenticated user can create/write their own user doc.
      // Any client can read any user profile.
      allow read: if true;
      allow write: if isSignedIn();
    }

    // This rule allows any authenticated user to perform any action on any other collection.
    // This is required for the admin panel to list collections like `testbenches`, `vessel_types`, etc.
    match /{path=**} {
        allow read, write: if isSignedIn();
    }
  }
}
